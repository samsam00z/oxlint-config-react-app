{
  "$schema": "./node_modules/oxlint/configuration-schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc",
    "eslint"
  ],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "error",
    "style": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "coverage/**",
    "node_modules/**",
    "public/**"
  ],
  "rules": {
    "eqeqeq": "error",
    "prefer-const": "error",
    "no-var": "error",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-explicit-any": "warn",
    "no-floating-promises": "warn",
    "consistent-type-imports": "warn",
    "complexity": ["warn", 12],
    "max-depth": ["warn", 3],
    "max-params": ["warn", 4],
    "max-lines": ["warn", 400],
    "max-lines-per-function": ["warn", 120],
    "no-magic-numbers": "off",
    "react/jsx-key": "error",
    "react/self-closing-comp": "warn",
    "react/react-in-jsx-scope": "off",
    "react/jsx-max-depth": "off",
    "sort-keys": "off",
    "no-ternary": "off",
    "one-var": "off",
    "sort-imports": "off",
    "func-style": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off",
    "curly": "off",
    "capitalized-comments": "off",
    "unicorn/prefer-includes": "warn",
    "unicorn/prefer-string-replace-all": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "no-magic-numbers": "off"
      }
    }
  ]
}
